datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  firstName           String
  lastName            String
  role                Role     @default(TEACHER)
  isActive            Boolean  @default(true)
  mustChangePassword  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relaciones
  teacherCourses Course[] @relation("TeacherCourses")
  logs           AuditLog[]

  @@map("users")
}

model Student {
  id         String        @id @default(uuid())
  code       String        @unique // Carné estudiantil
  firstName  String
  lastName   String
  email      String        @unique
  status     StudentStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relaciones
  enrollments Enrollment[]
  grades      Grade[]

  @@map("students")
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  credits     Int
  teacherId   String
  isActive    Boolean  @default(true)
  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  enrollments Enrollment[]
  grades      Grade[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Grade {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  title      String   // Parcial 1, Tarea 1, Examen Final, etc.
  score      Float
  maxScore   Float    @default(100)
  percentage Float    // Ponderación de la nota sobre 100%
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("grades")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}